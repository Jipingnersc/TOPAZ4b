# include file for fimm, intel compilers
CF90 = ifort
CF77 = $(CF90)
CC = icc
LD =  $(CF90)

# CPP, used internally by compilers - note that some compilers
# need special options for this, consult compiler manual if in trouble
CPP= /usr/bin/cpp -P -traditional-cpp
CPPARCH = -DIA32 -DREA8 -DMPI -DSERIA_IO -DTIMER -DIARGC -DFFTW 

#NCAR graphics compiler wrappers
#NCARGCF90=ncargf90
#NCARGCF77=ncargf77
#NCARGCC=ncargcc
#NCARGLD=ncargf90

# Flags for fixed/free format
F90FLG= -free
F77FLG = -nofree

NETCDF_INCLUDE_OPTS=/cluster/software/easybuild/software/netCDF-Fortran/4.4.4-intel-2016b/include

# Compiler flags - real*8 version 
#FFLAGS= -real_size 64 -convert big_endian -O2  -g
FFLAGS= -g -convert big_endian -assume byterecl -cm -vec_reprot0 -w -o2 -r8 -I$(NETCDF_INCLUDE_OPTS)

CFLAGS= -O2 

# Compiler flags - real*4 version (Needed for NCARG routines)
FFLAGSR4= -real_size 32 -convert big_endian -O2  -g
CFLAGSR4= -O2

# Linker flags
LINKFLAGS= $(FFLAGS)  

#Libraries, Netcdf, FFTW, LAPACK
#LIBS = -L/local/netcdf/lib -lnetcdf -lnetcdff -L/local/fftw/lib/ -lfftw3 

#LIBS = -L/cluster/software/easybuild/software/netCDF-Fortran/4.4.4-intel-2016b/lib -lnetcdf -lnetcdff -L/cluster/software/easybuild/software/FFTW/3.3.6-intel-2017a/lib -lfftw3

LIBS = -L/cluster/software/easybuild/software/netCDF-Fortran/4.4.4-intel-2016b/lib -lnetcdf -lnetcdff -L/cluster/software/easybuild/software/FFTW/3.3.6-intel-2017a/lib -lfftw3 -L/cluster/software/easybuild/software/imkl/11.3.3.210-iimpi-2016b/mkl/lib/intel64 -lmkl_lapack -liomp5 




# Define CPP flags consistent with libs above
#CPPFLAGS=-DFFTW -DLAPACK
CPPFLAGS=-DFFTW 
