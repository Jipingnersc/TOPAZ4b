# include file for fimm, intel compilers
CF90 = ifort
CF77 = $(CF90)
CC = icc
LD =  $(CF90)

# CPP, used internally by compilers - note that some compilers
# need special options for this, consult compiler manual if in trouble
CPP= /usr/bin/cpp -P -traditional-cpp
#CPPARCH = -DIA32 -DREA8 -DMPI -DSERIA_IO -DTIMER -DIARGC -DFFTW -DLAPACK 
CPPARCH = -DIA32 -DREA8 -DSERIA_IO -DTIMER -DIARGC -DFFTW -DLAPACK 

#NCAR graphics compiler wrappers
#NCARGCF90=ncargf90
#NCARGCF77=ncargf77
#NCARGCC=ncargcc
#NCARGLD=ncargf90

# Flags for fixed/free format
F90FLG= -free
F77FLG = -nofree

NETCDF_INCLUDE_OPTS=$(SURFSARA_NETCDFF_ROOT)/include
NETCDF_LIB_OPTS=$(SURFSARA_NETCDFF_ROOT)/lib64
##NETCDF_INCLUDE_OPTS=/cluster/software/netCDF-Fortran/4.4.4-intel-2017a-HDF5-1.8.18/include


# Compiler flags - real*8 version 
#FFLAGS= -real_size 64 -convert big_endian -O2  -g

FFLAGS= -g -convert big_endian -assume byterecl -cm -vec_report0 -w -O2 -r8 
#FFLAGS= -g -convert big_endian -assume byterecl -cm -vec_report0 -w -O2 -xAVX -axCORE-AVX2 -r8 -I$(NETCDF_INCLUDE_OPTS)

CFLAGS= -O2 

#FFLAGS= -g -convert big_endian -assume byterecl -cm -vec_report0 -w -O2 -parallel -r8 -I$(NETCDF_INCLUDE_OPTS)
#CFLAGS= -O2 -parallel

#FFLAGS= -g -convert big_endian -assume byterecl -xCORE-AVX2 -O3 -no-prec-div -qopt-prefetch -no-ansi-alias -qopt-mem-layout-trans=2  -r8 -I$(NETCDF_INCLUDE_OPTS)
#CFLAGS= -O3

# Compiler flags - real*4 version (Needed for NCARG routines)
FFLAGSR4= -real_size 32 -convert big_endian -O3 -g
CFLAGSR4= -O3

# Linker flags
LINKFLAGS= $(FFLAGS)  

#Libraries, Netcdf, FFTW, LAPACK
#LIBS = -lnetcdf -lnetcdff -lfftw3 -lmkl -L$(NETCDF_LIB_OPTS)
LIBS = -lnetcdf -lnetcdff -lfftw3 -lmkl 

# Define CPP flags consistent with libs above
CPPFLAGS=-DFFTW -DLAPACK 
