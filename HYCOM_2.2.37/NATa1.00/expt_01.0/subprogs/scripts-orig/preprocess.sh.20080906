   if [ -d ./pcip ]; then
     if [ -s ./pcip/precip_${NEXT_SEGMENT}.a -a \
          -s ./pcip/precip_${NEXT_SEGMENT}.b    ]; then
C
C ---   next segments pcip already exist.
C
     else
       cd ./pcip
       #/bin/rm -f ${E}p${YXX}${B}.com ${E}p${YXX}${B}.log
       #awk -f $D/../${E}.awk y01=${YXX} ab=${B} $D/../${E}P.com > ${E}p${YXX}${B}.com
