C
     else
       cd ./ssto
       #/bin/rm -f ${E}o${YXX}${B}.com ${E}o${YXX}${B}.log
       #awk -f $D/../${E}.awk y01=${YXX} ab=${B} $D/../${E}O.com > ${E}o${YXX}${B}.com
