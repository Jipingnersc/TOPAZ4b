if [ $NMPI -eq 0 ] ; then
   C
   C --- run the model, without MPI or SHMEM
   C
   if [ $NOMP -eq 0 ] ; then
     export NOMP=1
   fi   
   C
else
   C
   C --- run the model, with MPI or SHMEM and perhaps also with OpenMP.
   C
   touch patch.input
   if [ ! -s patch.input ] ; then
     C
     C --- patch.input is always required for MPI or SHMEM.
     C
     cd $D/..
     /bin/mv LIST LIST_BADRUN
     echo "BADRUN" > LIST
     exit
   fi

   C 
   C --- Run hycom here

fi

C
touch   PIPE_DEBUG
/bin/rm PIPE_DEBUG

C
C --- archive output in a separate tar directory
C
touch archv.dummy.a archv.dummy.b archv.dummy.txt
C
if [ -d ./SAVE ]; then
  for f in archv.*.a ; do
    /bin/ln ${f} SAVE/${f}
  done
  for f in archv.*.b ; do
    /bin/ln ${f} SAVE/${f}
  done
  for f  in archv.*.txt ; do
    /bin/ln ${f} SAVE/${f}
  done
fi
