#
#@$-lt 0:04:00
#@$-lT 0:04:00
#@$-lm 4mw
#@$-lM 4mw
#@$-s  /bin/csh
#@$
#
set echo
set time = 1
C
setenv OS `uname`
switch ($OS)
case 'SunOS':
    breaksw
case 'Linux':
    breaksw
case 'OSF1':
    breaksw
case 'IRIX64':
    breaksw
case 'AIX':
    breaksw
case 'unicosmk':
    breaksw
default:
    echo 'Unknown Operating System: ' $OS
    exit (1)
endsw
C
C --- Interpolate Levitus climtology to a HYCOM region.
C --- KSIGMA=0 for _sig0_ fields
C
switch ($OS)
case 'SunOS':
    if (-e /scr) then
      setenv pget ~wallcraf/bin/pget
      setenv pput ~wallcraf/bin/pput
    else
      setenv pget cp
      setenv pput cp
    endif
    breaksw
case 'XXX':
    setenv pget ~wallcraf/bin/pget
    setenv pput ~wallcraf/bin/pput
    breaksw
default:
    setenv pget cp
    setenv pput cp
endsw
C
C --- P is primary path,
C --- S is scratch   directory,
C --- D is permanent directory,
C --- L is Levitus   directory
C
#setenv P hycom/ATLb2.00/relax/GDEM
setenv P Progs/HYCOM_2.2.12/hycom/NATa1.00/relax/GDEM
C
switch ($OS)
case 'SunOS':
    if (-e /scr) then
#                  NAVO MSRC
      setenv S /scr/${user}/$P
      setenv D            ~/$P
      setenv L ~/clim/gdem3
    else if (-e /net/hermes/scrb) then
#                  NRLSSC
      setenv S /net/hermes/scrb/${user}/$P
      setenv D                        ~/$P
      setenv L ~/clim/gdem3
    else
#                  Single Disk
      setenv S ~/$P/SCRATCH
      setenv D ~/$P
      setenv L ~/clim/gdem3
    endif
    breaksw
case 'Linux':
    if (-e /external/fast) then
#                  NRLSSC
      setenv S /external/fast/${user}/$P
      setenv D                      ~/$P
      setenv L /external/fast/${user}/clim/gdem3
    else
#                  Single Disk
      setenv S ~/$P/SCRATCH
      setenv D ~/$P
      #setenv L ~/clim/gdem3
      setenv L /work/shared/nersc/msc/GDEM/HycomClim/
    endif
    breaksw
default:
#                  Single Disk
    setenv S ~/$P/SCRATCH
    setenv D ~/$P
    setenv L ~/clim/gdem3
endsw
C
mkdir -p $S
cd       $S
C
touch   z_gdem3
/bin/rm z_gdem3
C
C --- 12 months
C
foreach MM ( 01 02 03 04 05 06 07 08 09 10 11 12 )
C
C --- Input.
C
C --- Download Levitus from:
C --- ftp://obelix.rsmas.miami.edu/awall/hycom/levitus_for_hycom.tar.gz
C
touch      fort.71 fort.73
/bin/rm -f fort.71 fort.73
${pget} $L/r_m${MM}.d fort.71 &
${pget} $L/s_m${MM}.d fort.73 &
C
touch regional.grid.a regional.grid.b
if (-z regional.grid.b) then
  ${pget} ${D}/../../topo/regional.grid.b regional.grid.b &
endif
if (-z regional.grid.a) then
  ${pget} ${D}/../../topo/regional.grid.a regional.grid.a &
endif
C
touch z_gdem3
if (-z z_gdem3) then
  ${pget} ${D}/../../../ALL/relax/src/z_gdem3 . &
endif
wait
chmod a+rx z_gdem3
C
switch ($OS)
case 'SunOS':
    /bin/rm -f core z_gdem3.trace
    touch core
    breaksw
default:
    /bin/rm -f core
    touch core
endsw
setenv FOR010A fort.10A
setenv FOR011A fort.11A
setenv FOR012A fort.12A
/bin/rm -f fort.10 fort.10A fort.11 fort.11A fort.12 fort.12A
./z_gdem3 <<E-o-D
 &AFTITL
  CTITLE = '1234567890123456789012345678901234567890',
  CTITLE = 'Levitus monthly',
 /
 &AFFLAG
  ICTYPE =   2,
  KSIGMA =   0,
  INTERP =   1,
  ITEST  =  40,
  JTEST  =  17,
  MONTH  = $MM,
 /
E-o-D
switch ($OS)
case 'SunOS':
    if (-e z_gdem3.trace) then
      cat z_gdem3.trace
    endif
    breaksw
default:
endsw
C
C --- Required Output, potential density and temperature.
C
${pput} fort.10  ${D}/temp_sig0_m${MM}.b
${pput} fort.10A ${D}/temp_sig0_m${MM}.a
${pput} fort.12  ${D}/dens_sig0_m${MM}.b
${pput} fort.12A ${D}/dens_sig0_m${MM}.a
C
C --- Optional Output.
C
${pput} fort.11  ${D}/saln_sig0_m${MM}.b
${pput} fort.11A ${D}/saln_sig0_m${MM}.a
C
C --- end of month foreach loop
C
/bin/rm fort.7[123]
end
C
C --- Delete all files.
C
#/bin/rm -f *
